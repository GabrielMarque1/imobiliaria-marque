	hierarchy 'Hierarquia de Datas'
		lineageTag: 7566c8be-1704-4ebc-b5aa-6351c129c4dc

		level Ano
			lineageTag: ceb4ce61-6358-41b0-b724-f1ecd6a6e0f4
			column: Ano

		level Trimestre
			lineageTag: da418d97-2f4e-4748-a6a5-59dfc92211f1
			column: Trimestre

		level 'Mês'
			lineageTag: be9333a8-7c23-4658-a3c6-acca814b9097
			column: 'Mês'

	partition dCalendario = calculated
		mode: import
		source =
				VAR _Inicio = DATE ( YEAR ( MIN ( fVendas[Data_Venda] ) ), 1, 1 )
				VAR _Fim = DATE ( YEAR ( MAX ( fVendas[Data_Venda] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        SELECTCOLUMNS ( CALENDAR ( _Inicio, _Fim ), "Data", [Date] ),
				        "Ano", YEAR ( [Data] ),
				        "Mês Nº", MONTH ( [Data] ),
				        "Mês", UPPER ( LEFT ( FORMAT ( [Data], "mmmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( [Data], "mmmm", "pt-BR" ), 2, 20 ),
				        "Mês Abrev", UPPER ( LEFT ( FORMAT ( [Data], "mmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( [Data], "mmm", "pt-BR" ), 2, 3 ),
				        "Ano Mês Nº", YEAR ( [Data] ) * 100 + MONTH ( [Data] ),
				        "Mês Ano", UPPER ( LEFT ( FORMAT ( [Data], "mmm", "pt-BR" ), 1 ) ) & MID ( FORMAT ( [Data], "mmm", "pt-BR" ), 2, 3 ) & "/" & FORMAT ( [Data], "yy" ),
				        "Trimestre", "T" & QUARTER ( [Data] ),
				        "Dia da Semana Nº", WEEKDAY ( [Data], 2 ),
				        "Dia da Semana", UPPER ( LEFT ( FORMAT ( [Data], "dddd", "pt-BR" ), 1 ) ) & MID ( FORMAT ( [Data], "dddd", "pt-BR" ), 2, 20 )
				    )

